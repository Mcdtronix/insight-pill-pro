[Unit]
Description=PharmInsight API (Django + Gunicorn) for pharminsight.mcdtronix.co.zw
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=notify
NotifyAccess=main
User=deploy
Group=deploy

# `current` is re-resolved on every (re)start, so a restart picks up the new release.
WorkingDirectory=/srv/apps/pharminsight/current/backend
# Gunicorn reads GUNICORN_* from here; Django also loads it through backend/.env.
EnvironmentFile=/srv/apps/pharminsight/shared/.env
ExecStart=/srv/apps/pharminsight/current/backend/.venv/bin/gunicorn config.wsgi:application \
    -c config/gunicorn.conf.py --bind 127.0.0.1:8003
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
# Model preloading happens before Gunicorn reports ready.
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=mixed
UMask=0027

# Sandboxing — the API writes only to the database.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
