DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Set POSTGRES_HOST and POSTGRES_PASSWORD for production. SQLite is for local development only.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_DB=pharmacy
# POSTGRES_USER=pharmacy
# POSTGRES_PASSWORD=replace-me
# Demo mode: treat this date as "today" so the 2024 datasets behave like a live pharmacy.
# DSS_DEMO_DATE=2024-12-31
# Password used by `manage.py create_demo_users` for the four demo accounts.
# DEMO_USER_PASSWORD=choose-a-strong-password

# --- Production (written for you by deploy/server/bootstrap-pharminsight.sh) ---
# SECURE_SSL_REDIRECT=false     # Nginx terminates TLS and redirects HTTP
# BEHIND_PROXY=true             # trust X-Forwarded-Proto; rate-limit the real client IP
# DSS_ALLOW_DEMO_DATE=true      # required to use DSS_DEMO_DATE when DJANGO_DEBUG=false
# DSS_PRELOAD_MODELS=true       # load the ML models once in Gunicorn's master process
# GUNICORN_WORKERS=2
